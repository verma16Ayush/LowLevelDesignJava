---
config:
  theme: dark
  look: handDrawn
---
classDiagram
class ParkingLot {
    - List~Floor~ floors
    - Gate entryGate
    - Gate exitGate

    + setFloors(List~Floor~) : void
    + getFloors() : List~Floor~
    + setEntryGate(Gate) : void
    + getEntryGate(Gate) : void
    + setExitGate(Gate) : void
    + getExitGate(Gate) : void
}

class Floor {
<<interface>>
    - List~ParkingSpot~ parkingSpots

    getParkingSpots() : List~ParkingSpot~
    setParkingSpots(List~ParkingSpots~) : void
    addParkingSpots(ParkingSpot) : String
    removeParkingSpot(String parkingSpotId)
}

class ParkingSpot {
<<interface>>
    - List<VehicleType> supportedVehicleTypes
    - isAvailable
    - ChargingStrategy
    - Vehicle OccupiedBy
    - DistanceFromExit
    - DistanceFromEntrance
    - Floor

    + isAvailable() : boolean
    + setIsAvailable() : boolean
    + addSupportedVehicle(VehicleType) : void
    + isVehicleSupported(VehicleType) : boolean
    + setVehicle(Vehicle) : void
    + removeVehicle() : void
    + getVehicle() : Vehicle 
    + getDistanceFromExit : int
    + getDistanceFromEntrance : int
    + getFloor : int
}

class Vehicle {
    <<interface>>
    List~VehicleType~ types
    String registrationNumber
}

class VehicleType{
    <<enumeration>> 
}

class Gate {
    <<interface>>
    -GateType type
    -String gateId

    +getGateType() : GateType
    +getGateId() : String
}

class EntryGate {
    - String Id
    - GateType type

    + generateTicket(ChargingStrategy, ParkingSpot) : Ticket
    + findParkingSpot(ParkingSpotFindingStrategy) : ParkingSpot
}

class ExitGate {
    - String Id
    - GateType type

    + calculatePrice(Ticket) : BigDecimal

}

class Ticket {
    - Instant issuedAt
    - Instant exitAt
    - ParkingSpot parkingSpot
    - Vehicle vehicle
    - ChargingStrategy chargingStrategy

    + setExitInstantToNow()
}

class ChargingStrategy {
    <<interface>>
}

class ParkingSpotFindingStrategy {
    <<interface>> 
}

ParkingLot"1" *-- "*"Floor: owns
Floor"1" *-- "*"ParkingSpot: owns
ParkingSpot"1" -- "*"VehicleType
ParkingSpot"1" -- "1"Vehicle
Vehicle"1" -- "*"VehicleType
ParkingLot"1" -- "*"Gate
Vehicle -- Ticket
EntryGate ..|> Gate
EntryGate ..> ChargingStrategy
EntryGate ..> ParkingSpotFindingStrategy
ExitGate ..> Ticket
ExitGate ..|> Gate
ParkingSpot"*" --o "1"Gate 